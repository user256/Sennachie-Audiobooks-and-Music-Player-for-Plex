<?xml version="1.0" encoding="utf-8"?>
<!--
  Ticket 141: nothing on the watch is backed up or transferred. The book is a copy the phone can send again, and its
  positions belong to the phone's account; neither should appear on another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
